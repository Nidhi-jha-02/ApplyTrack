# ===================================================================
# ApplyTrack - Database Configuration Template
# ===================================================================
# Copy this file to "db.properties" in the project root directory
# and update the values with your local MySQL/MariaDB credentials.
#
# NOTE: "db.properties" is already listed in .gitignore and will NOT
# be committed to version control.
# ===================================================================

# JDBC Connection URL
# For local MySQL / MariaDB on standard port 3306:
db.url=jdbc:mysql://127.0.0.1:3306/applytrack_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database Username (default is typically "root")
db.username=root

# Database Password (set your local root/user password)
db.password=your_password_here

# JDBC Driver Class Name (MySQL Connector/J)
db.driver=com.mysql.cj.jdbc.Driver

