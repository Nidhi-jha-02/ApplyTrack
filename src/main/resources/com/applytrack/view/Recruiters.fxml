<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" style="-fx-padding: 20px; -fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.applytrack.controller.RecruitersController">
    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Recruiter Directory" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Campus talent partners, corporate recruiters, direct contact details &amp; application links" />
        </VBox>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Label fx:id="recordCountBadge" style="-fx-background-color: #e0e7ff; -fx-text-fill: #4338ca; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 6 14 6 14; -fx-background-radius: 20px;" text="0 Recruiters" />
            <Button fx:id="addRecruiterBtn" onAction="#handleAddRecruiter" styleClass="btn-primary" text="+ Add Recruiter" />
            <Button fx:id="refreshBtn" onAction="#handleRefresh" styleClass="btn-secondary" text="↻ Refresh" />
        </HBox>
    </HBox>

    <!-- Search, Filter & Sort Controls Card -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card" style="-fx-padding: 12px 16px;">
        <TextField fx:id="searchField" maxWidth="320.0" promptText="Search name, email, phone, company, notes..." HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="companyFilterBox" prefWidth="200.0" promptText="Filter by Company" />
        <ComboBox fx:id="sortByBox" prefWidth="220.0" promptText="Sort Recruiters" />
        <Button fx:id="resetFiltersBtn" onAction="#handleResetFilters" styleClass="btn-secondary" text="Reset Filters" />
    </HBox>

    <!-- Status Feedback Banner -->
    <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 0 4 0 4;">
        <Label fx:id="statusMessageLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 500;" text="Ready" />
    </HBox>

    <!-- Table & Empty State StackPane -->
    <StackPane VBox.vgrow="ALWAYS">
        <TableView fx:id="recruitersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameCol" prefWidth="200.0" text="Recruiter Name" />
                <TableColumn fx:id="companyCol" prefWidth="180.0" text="Company" />
                <TableColumn fx:id="emailCol" prefWidth="210.0" text="Email Address" />
                <TableColumn fx:id="phoneCol" prefWidth="150.0" text="Phone Number" />
                <TableColumn fx:id="appsCol" prefWidth="140.0" text="Applications" />
                <TableColumn fx:id="infoCol" prefWidth="180.0" text="LinkedIn / Notes" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
        </TableView>

        <!-- Empty State Container -->
        <VBox fx:id="emptyStateContainer" alignment="CENTER" spacing="12.0" styleClass="empty-state-container" visible="false">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="No Recruiters Found" />
            <Label styleClass="empty-state-text" text="There are no recruiter contacts matching your current search or filter criteria." />
            <Button onAction="#handleAddRecruiter" styleClass="btn-primary" text="+ Add a Recruiter Now" />
        </VBox>
    </StackPane>

    <!-- Bottom Action Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card" style="-fx-padding: 12px 16px;">
        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Selected Recruiter:" />
        <Label fx:id="selectedRecruiterLabel" style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="None selected (click a row above)" HBox.hgrow="ALWAYS" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="viewDetailsBtn" disable="true" onAction="#handleViewDetails" styleClass="btn-secondary" text="View Details &amp; Pipeline" />
        <Button fx:id="editBtn" disable="true" onAction="#handleEditRecruiter" styleClass="btn-secondary" text="Edit Recruiter" />
        <Button fx:id="deleteBtn" disable="true" onAction="#handleDeleteRecruiter" styleClass="btn-danger" text="Delete Recruiter" />
    </HBox>
</VBox>

