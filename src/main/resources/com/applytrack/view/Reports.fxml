<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.applytrack.controller.ReportsController">
    <children>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <VBox spacing="20.0" style="-fx-padding: 10px;">
                    <!-- Header Bar -->
                    <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-padding: 18px 24px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-border-width: 1px;">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Reports &amp; Data Export Center" />
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Generate and download official PDF summaries and Excel workbooks (.xlsx) from your database records." />
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <Label style="-fx-font-size: 11.5px; -fx-text-fill: #94a3b8; -fx-font-weight: 600;" text="STANDALONE EXPORTER" />
                        </HBox>
                    </HBox>

                    <!-- Status / Feedback Banner -->
                    <HBox fx:id="feedbackBanner" alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f0fdf4; -fx-border-color: #bbf7d0; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-padding: 12px 18px;" visible="false">
                        <Label fx:id="feedbackIcon" style="-fx-font-size: 16px;" text="✅" />
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="feedbackTitle" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #166534;" text="Report Exported Successfully" />
                            <Label fx:id="feedbackDetails" style="-fx-font-size: 11.5px; -fx-text-fill: #15803d;" text="Saved to file location" />
                        </VBox>
                        <Button fx:id="dismissFeedbackBtn" onAction="#handleDismissFeedback" style="-fx-background-color: transparent; -fx-text-fill: #166534; -fx-font-weight: bold; -fx-cursor: hand;" text="✕" />
                    </HBox>

                    <!-- Report Configuration & Generation Card -->
                    <VBox spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-padding: 22px 24px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-border-width: 1px;">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="1. Select Report Type &amp; Scope" />

                        <!-- Row 1: Report Type Selection -->
                        <VBox spacing="6.0">
                            <Label style="-fx-font-size: 12.5px; -fx-font-weight: 600; -fx-text-fill: #334155;" text="Choose Report Type:" />
                            <ComboBox fx:id="reportTypeCombo" onAction="#handleReportTypeChanged" prefHeight="38.0" prefWidth="480.0" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 13px; -fx-cursor: hand;" />
                            <Label fx:id="reportDescriptionLabel" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Comprehensive log of all submitted applications, roles, dates, deadlines, salaries, and current statuses." wrapText="true" />
                        </VBox>

                        <Separator style="-fx-opacity: 0.6;" />

                        <!-- Row 2: Date Range Filter -->
                        <VBox spacing="10.0">
                            <Label style="-fx-font-size: 12.5px; -fx-font-weight: 600; -fx-text-fill: #334155;" text="Choose Date Scope:" />
                            <HBox alignment="CENTER_LEFT" spacing="16.0">
                                <ComboBox fx:id="dateRangeCombo" onAction="#handleDateRangeChanged" prefHeight="38.0" prefWidth="240.0" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 13px; -fx-cursor: hand;" />

                                <!-- Custom Date Pickers (visible only when Custom Date Range selected) -->
                                <HBox fx:id="customDateBox" alignment="CENTER_LEFT" spacing="10.0" visible="false">
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="From:" />
                                    <DatePicker fx:id="startDatePicker" prefHeight="38.0" prefWidth="150.0" promptText="Start Date" style="-fx-background-radius: 8px;" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="To:" />
                                    <DatePicker fx:id="endDatePicker" prefHeight="38.0" prefWidth="150.0" promptText="End Date" style="-fx-background-radius: 8px;" />
                                    <Button onAction="#handleApplyCustomRange" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-font-size: 12.5px; -fx-font-weight: 600; -fx-padding: 8 14 8 14; -fx-cursor: hand;" text="Apply" />
                                </HBox>
                            </HBox>
                        </VBox>

                        <Separator style="-fx-opacity: 0.6;" />

                        <!-- Row 3: Export Action Buttons -->
                        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 6 0 0 0;">
                            <Button fx:id="exportPdfBtn" onAction="#handleExportPdf" prefHeight="42.0" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13.5px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-padding: 8 24 8 24;" text="📄 Export as PDF" />
                            <Button fx:id="exportExcelBtn" onAction="#handleExportExcel" prefHeight="42.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13.5px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-padding: 8 24 8 24;" text="📊 Export as Excel (.xlsx)" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleRefreshPreview" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-text-fill: #475569; -fx-font-weight: 600; -fx-font-size: 12.5px; -fx-padding: 8 16 8 16; -fx-cursor: hand;" text="↻ Refresh Preview" />
                        </HBox>
                    </VBox>

                    <!-- Section 2: Live Report Preview & Scope Summary -->
                    <VBox spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 12px; -fx-padding: 22px 24px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-border-width: 1px;">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="2. Live Scope Summary &amp; Record Count" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="previewScopeBadge" style="-fx-background-color: #e0e7ff; -fx-text-fill: #4338ca; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-padding: 4 10 4 10; -fx-background-radius: 12px;" text="All Time" />
                            <Label fx:id="previewRecordCountBadge" style="-fx-background-color: #ecfdf5; -fx-text-fill: #047857; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-padding: 4 10 4 10; -fx-background-radius: 12px;" text="0 Records Found" />
                        </HBox>

                        <Label style="-fx-font-size: 12.5px; -fx-text-fill: #64748b;" text="The following summarized key performance indicators will be highlighted at the top of your exported file:" />

                        <!-- 4 Summary KPI Cards Grid -->
                        <GridPane fx:id="kpiGrid" hgap="14.0" vgap="14.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="90.0" prefHeight="95.0" />
                            </rowConstraints>

                            <VBox fx:id="kpiCard1" spacing="4.0" style="-fx-background-color: #f8fafc; -fx-padding: 14px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-border-width: 1px;" GridPane.columnIndex="0">
                                <Label fx:id="kpiLabel1" style="-fx-font-size: 11.5px; -fx-text-fill: #64748b; -fx-font-weight: 600;" text="Total Records" />
                                <Label fx:id="kpiValue1" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0" />
                            </VBox>

                            <VBox fx:id="kpiCard2" spacing="4.0" style="-fx-background-color: #f8fafc; -fx-padding: 14px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-border-width: 1px;" GridPane.columnIndex="1">
                                <Label fx:id="kpiLabel2" style="-fx-font-size: 11.5px; -fx-text-fill: #64748b; -fx-font-weight: 600;" text="Active Ongoing" />
                                <Label fx:id="kpiValue2" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0284c7;" text="0" />
                            </VBox>

                            <VBox fx:id="kpiCard3" spacing="4.0" style="-fx-background-color: #f8fafc; -fx-padding: 14px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-border-width: 1px;" GridPane.columnIndex="2">
                                <Label fx:id="kpiLabel3" style="-fx-font-size: 11.5px; -fx-text-fill: #64748b; -fx-font-weight: 600;" text="Selected Offers" />
                                <Label fx:id="kpiValue3" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="0" />
                            </VBox>

                            <VBox fx:id="kpiCard4" spacing="4.0" style="-fx-background-color: #f8fafc; -fx-padding: 14px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-border-width: 1px;" GridPane.columnIndex="3">
                                <Label fx:id="kpiLabel4" style="-fx-font-size: 11.5px; -fx-text-fill: #64748b; -fx-font-weight: 600;" text="Rejected / Terminal" />
                                <Label fx:id="kpiValue4" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="0" />
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Section 3: Professional Format Highlights -->
                    <GridPane hgap="16.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0" />
                            <ColumnConstraints percentWidth="50.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="130.0" />
                        </rowConstraints>

                        <!-- PDF Details -->
                        <VBox spacing="8.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 12px; -fx-padding: 18px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-border-width: 1px;" GridPane.columnIndex="0">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4338ca;" text="📄 PDF Format Specifications" />
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-line-spacing: 3px;" text="• Multi-page table layout with automatic pagination &amp; running page headers.&#10;• Styled ApplyTrack branding banner with generation timestamp and candidate metadata.&#10;• Alternating row striping and confidential watermark footers.&#10;• Native vector typography using Apache PDFBox 3.0." wrapText="true" />
                        </VBox>

                        <!-- Excel Details -->
                        <VBox spacing="8.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 12px; -fx-padding: 18px; -fx-border-color: #e2e8f0; -fx-border-radius: 12px; -fx-border-width: 1px;" GridPane.columnIndex="1">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #047857;" text="📊 Excel Format Specifications" />
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-line-spacing: 3px;" text="• Multi-sheet workbooks (.xlsx) with dedicated Executive Overview tab.&#10;• Styled header rows in deep slate with frozen top pane for easy scrolling.&#10;• Formatted numeric columns: Currency ($#,##0.00), Percentages (0.0%), Dates (yyyy-mm-dd).&#10;• Dynamic auto-sizing of column widths based on content volume." wrapText="true" />
                        </VBox>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Loading Overlay -->
        <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="12.0" style="-fx-background-color: rgba(248, 250, 252, 0.7);" visible="false">
            <ProgressIndicator prefHeight="48.0" prefWidth="48.0" />
            <Label fx:id="loadingText" style="-fx-font-size: 13.5px; -fx-text-fill: #475569; -fx-font-weight: 600;" text="Compiling report data and generating document..." />
        </VBox>
    </children>
</StackPane>

